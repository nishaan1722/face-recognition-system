# Copy this file to .env and adjust for your deployment.
# (The app currently reads these from the real environment; a tool like
# python-dotenv or `export $(cat .env | xargs)` before launch works fine.)

# Shared secret required in the X-Admin-Token header for registration,
# roster listing, and deletion. CHANGE THIS before any real deployment.
ADMIN_TOKEN=change-me-admin-token

# Lower = stricter matching (fewer false accepts, more false rejects).
# Tune against your camera/lighting; 70 is a reasonable starting point.
LBPH_MAX_DISTANCE=70

# Where the SQLite DB and stored face crops live.
DATA_DIR=./data
